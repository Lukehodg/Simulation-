# Copy to .env, or store these in the macOS Keychain instead:
#   security add-generic-password -a health -s WHOOP_CLIENT_ID -w '...'
#
# The app reads each secret from the environment first, then the Keychain,
# then ~/.config/health/secrets.json. Nothing is ever read from the repo.

WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
HEVY_API_KEY=

# Needed for `health brief`. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: `health brief --notify` texts the brief to this handle over iMessage
# (message-to-self). Your own number, e.g. +447700900123, or Apple ID email.
HEALTH_NOTIFY_IMESSAGE=

# Where Health Auto Export drops its JSON on this machine.
HEALTH_APPLE_EXPORT_DIR=~/Library/Mobile Documents/com~apple~CloudDocs/HealthAutoExport

# Your timezone, used to decide which day a 00:30 measurement belongs to.
HEALTH_TIMEZONE=Europe/London
