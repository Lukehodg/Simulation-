# Copy to .env, or store these in the macOS Keychain instead:
#   security add-generic-password -a health -s WHOOP_CLIENT_ID -w '...'
#
# The app reads each secret from the environment first, then the Keychain,
# then ~/.config/health/secrets.json. Nothing is ever read from the repo.

WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
HEVY_API_KEY=

# Needed for `health brief`. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Only if that key was created at the organisation level rather than inside a
# workspace (the API says "not scoped to a workspace"). Console → Settings →
# Workspaces shows the ID. A workspace-scoped key does not need this.
# ANTHROPIC_WORKSPACE_ID=

# How `--notify` gets the brief and the alerts onto your phone. Set ONE of the
# two blocks below; with both set, Pushover wins unless HEALTH_NOTIFY_CHANNEL
# says otherwise (pushover | imessage).

# Pushover — works on any OS, and the only option on Windows. Your user key is
# on pushover.net; the token comes from an application you create at
# pushover.net/apps. Note this is the one channel where the brief's text passes
# through a third party's servers.
HEALTH_PUSHOVER_USER=
PUSHOVER_API_TOKEN=

# iMessage (macOS only) — a message to yourself, so the numbers stay on the
# same iCloud path as your Health data. Your own number, e.g. +447700900123,
# or Apple ID email.
HEALTH_NOTIFY_IMESSAGE=

# HEALTH_NOTIFY_CHANNEL=pushover

# The chart card attached to the morning brief on Pushover: dark (default) or light.
# HEALTH_CARD_THEME=dark

# Where Health Auto Export drops its JSON on this machine.
HEALTH_APPLE_EXPORT_DIR=~/Library/Mobile Documents/com~apple~CloudDocs/HealthAutoExport

# Your timezone, used to decide which day a 00:30 measurement belongs to.
HEALTH_TIMEZONE=Europe/London
